{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Play (debug C#)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "/usr/bin/godot-mono",
      "args": ["--path", "${workspaceFolder}"],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "internalConsole"
    },
    {
      "name": "Launch Godot editor (debug C#)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "/usr/bin/godot-mono",
      "args": ["--path", "${workspaceFolder}", "--editor"],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "internalConsole"
    },
    {
      "name": "Attach to Godot process",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}"
    }
  ]
}
